VITE_APP_BASE_API=/dev-api
# 开发服务入口：指向本地新版后端（localhost:8080），与生产 /prod-api 同一条网关规则
VITE_API_TARGET=http://localhost:8080

# 本地开发媒体回源：本机 uploadPath 里没有的 /profile/** 原件，改从远端存储读取（仅 dev server 生效）
VITE_REMOTE_MEDIA_BASE=http://192.168.100.3:1100/prod-api
VITE_LOCAL_PROFILE_DIR=../smart-script-backend/uploadPath
